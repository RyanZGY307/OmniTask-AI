generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-conversation"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_CONVERSATION")
}

// ============================================================
// Conversation — conversation
// Models: CONVERSATION
// ============================================================

model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("新对话")
  userId    String
  isPinned  Boolean   @default(false)
  safetyWarnings Int @default(0)
  isSafetyFlagged Boolean @default(false)
  // 受限事项历史：每次敏感命中的标签数组的 JSON 数组（只保留最近 50 次）。
  // 用于按“同一受限事项”累计警告次数（无关话题不继承计数）。
  safetyTopicHistory String @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  files     WorkspaceFile[]
}

// ============================================================
// WorkspaceFile — 对话文件工作台（把回答解析成可读可改的文件）
// path 是相对路径（无前导 /、无 ..），(conversationId, path) 唯一。
// ============================================================

model WorkspaceFile {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String? // 从哪条消息提取（溯源；手工创建时为空）
  path           String
  content        String
  language       String       @default("txt")
  source         String       @default("extracted") // extracted | manual
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, path])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  // 对话内单调序号（对话记忆管理的事实依据）：压缩截止位置、
  // "不误删压缩期间新消息"都依赖它。历史行由迁移回填（幂等）。
  seq            Int?
  messageType    String       @default("text")
  model          String?
  mode           String?
  metadata       String?
  tokenCount     Int          @default(0)
  creditsCost    Float        @default(0)
  createdAt      DateTime     @default(now())
}

// ============================================================
// FlaggedConversation — 敏感对话标记（拒绝时落档快照）
// messagesJson: 最近 N 对用户与 AI 消息的 JSON 数组 [{role,content}]
// ============================================================

model FlaggedConversation {
  id             String       @id @default(cuid())
  userId         String
  username       String       @default("")
  conversationId String
  level          String       // "medium" | "high"
  reason         String?
  model          String?
  warningCount   Int          @default(0)
  uploadedPairs  Int          @default(0)
  messagesJson   String       @default("[]")
  // 触发本次标记的用户消息 id：同一消息重试只落一条档（幂等键）
  sourceMessageId String?     @unique
  // 命中的敏感标签（逗号分隔），用于按“同一受限事项”累计警告次数
  topics          String?
  // 落档实际结果：pending 写入中 / ok 已提交 / failed 提交失败（拒绝本身不受影响）
  uploadStatus    String      @default("ok")
  // 数据保留期限：到期由清理任务删除（默认 180 天，见 SAFETY_FLAG_RETENTION_DAYS）
  retentionUntil DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([conversationId])
  @@index([retentionUntil])
}

// ================================================================
// 对话记忆管理系统（context compression）
// 迁移见 migrations-conversation.sql（幂等 DDL）。
// 三张表的语义边界：
//   ConversationSummary     —— 已提交的累积摘要（版本化，每对话一条）
//   ContextCompressionTask  —— 压缩任务（冻结范围 + 乐观锁 + 状态机）
//   CompressionSegment      —— 分段中间结果（可恢复、幂等）
// ================================================================

model ConversationSummary {
  id             String   @id @default(cuid())
  conversationId String   @unique
  userId         String
  content        String
  coveredToSeq   Int      @default(0)
  coveredFromSeq Int      @default(1)
  version        Int      @default(1)
  modelId        String?
  structured     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model ContextCompressionTask {
  id                 String   @id @default(cuid())
  conversationId     String
  userId             String
  triggerReason      String
  sourceStartSeq     Int
  sourceEndSeq       Int
  baseSummaryVersion Int      @default(0)
  status             String   @default("PENDING")
  modelId            String?
  segmentCount       Int      @default(0)
  segmentsDone       Int      @default(0)
  mergeLevel         Int      @default(0)
  inputTokens        Int      @default(0)
  outputTokens       Int      @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  errorDetails       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([conversationId, status])
  @@index([userId, createdAt])
}

model CompressionSegment {
  id              String   @id @default(cuid())
  taskId          String
  conversationId  String
  segmentIndex    Int
  sourceStartSeq  Int
  sourceEndSeq    Int
  level           String   @default("SEGMENT")
  parentSegmentId String?
  content         String
  status          String   @default("PENDING")
  modelId         String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  retryCount      Int      @default(0)
  errorDetails    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([taskId, segmentIndex])
  @@index([taskId, status])
}
