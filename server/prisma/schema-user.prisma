  evidenceSummary String?
  reason          String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([paymentId])
  @@index([orderId])
  @@index([status])
}

model PaymentVerification {
