model Payment {
  id                    String            @id @default(cuid())
  provider              String
  providerTransactionId String?
  providerReference     String?
  providerAccountId     String?

  orderId               String?
  order                 PaymentOrder?     @relation(fields: [orderId], references: [orderId])
  userId                String?
  user                  User?             @relation(fields: [userId], references: [id])

  amount                Float
  currency              String
status String @default("PENDING")

  payerDisplayName      String?
  payerPhone            String?
  payerEmail            String?
  payerAccountId        String?

  recipientDisplayName  String?
  recipientAccountId    String?

  occurredAt            DateTime?
  receivedAt            DateTime          @default(now())

  rawProviderData       String?
  normalizedData        String?

attributionStatus String @default("UNMATCHED")
  verificationStatus    String            @default("pending")

  idempotencyKey        String?           @unique
  sourceType            String?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  evidences             PaymentEvidence[]
  attributions          PaymentAttribution[]
  verifications         PaymentVerification[]
  creditLedgerEntries   CreditLedger[]
  refund                Refund?

  @@index([provider, providerTransactionId])
  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([attributionStatus])
  @@index([createdAt])
}

model PaymentEvidence {
  id          String           @id @default(cuid())
