// ================================================================
// Provider connections — admin-managed Base URLs + API key pools.
// provider = routing family key: 'agnes' | 'google' | 'openai' | 'deepseek'
//   | 'xiaomi' | 'custom-<slug>'. apiKeys = JSON string array (<= 30).
// ================================================================
model ProviderConnection {
  provider       String   @default("")
  tier           String   @default("FREE") // "FREE" | "PRO" — 免费/Pro 供应商完全分离
  label          String   @default("")
  baseUrl        String // 完整 URL（不再拼接），如 https://apihub.agnes-ai.com/v1/chat/completions
  baseUrlRoot    String?
  apiKeys        String   @default("[]") // JSON 数组，无数量上限
  apiLimit       String   @default("") // JSON RateLimitBlock — 单 API 独立额度（每把 key）
  carrierLimit   String   @default("") // JSON RateLimitBlock — 该供应商所有 API 统一额度
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@id([provider, tier])
}

model ModelConfig {
  modelKey          String   @id
  provider          String   @default("custom")
  apiModel          String   @default("")
  displayName       String   @default("") // 空=前端自动去前缀/后缀推导
  tier              String   @default("FREE")
  maxTokens         Int      @default(8192)
  contextWindow     Int      @default(32768)
  costPer1k         Float    @default(0) // 积分/1000 token；0=免费；Pro 手动输入
  category          String   @default("general")
  vendor            String   @default("") // 厂商显示分类（ChatGPT/Claude/Gemini…）；空=按 provider 自动
  rateLimit         String   @default("") // JSON RateLimitBlock — 调用模型独立额度
  status            String   @default("online")
  enabled           Boolean  @default(true)
  capabilities      String @default("")
  supportsReasoning Boolean  @default(false)
  supportsTools     Boolean  @default(false)
  supportsVision    Boolean  @default(false)
  supportsStreaming Boolean  @default(true)
  supportsStructuredOutput Boolean @default(false)
  qualityProfile    Int      @default(5)
  speedProfile      Int      @default(5)
  reliabilityProfile Int     @default(5)
  overrideKeys      String @default("") // which fields are overridden vs defaults
  lastSyncedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

