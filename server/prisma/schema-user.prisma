generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client-user"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_USER")
}

// ============================================================
// User — user
// Models: USER
// ============================================================

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  username         String           @unique
  passwordHash     String
  avatar           String?
  gender           String?
  region           String           @default("CN")
  language         String           @default("zh-CN")
  currency         String           @default("USD")
role String @default("USER")
 subscriptionTier String @default("STANDARD")
  subscriptionEnd  DateTime?
  isActive         Boolean          @default(true)
  creditBalance    Float            @default(0)
  frozenCredits    Float            @default(0)
  bonusCreditsUsed Float            @default(0)
  dailyThinkUsed   Int              @default(0)
  dailyThinkReset  DateTime         @default(now())
  dailyVideoUsed   Int              @default(0)
  dailyVideoReset  DateTime         @default(now())
  dailyResearchUsed  Int            @default(0)
  dailyResearchReset DateTime       @default(now())
  evoSignalsToday  Int              @default(0)
  evoSignalsReset  DateTime         @default(now())
  evolutionOptOut  Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // ===== Existing relations =====
  settings           UserSetting?
  memoryEntries      MemoryEntry[]
  creditTransactions CreditTransaction[]
  creditBatches      CreditBatch[]
  orders             PaymentOrder[]
  logs               LogEntry[]
  modelUsage         ModelUsage[]
  feedbacks          Feedback[]

  // ===== Memory Runtime relations =====
  userProfile        UserProfile?
  userPreferences    UserPreference[]
  userRequirements   UserRequirement[]
  userHabits         UserHabit[]
  userInterests      UserInterest[]
  curationJobs       CurationJob[]

  domainProfiles     DomainProfile[]
  languageProfiles   LanguageProfile[]
  longTermMemories   LongTermMemory[]
  fileRecords        FileRecord[]
  payments           Payment[]
  creditLedgers      CreditLedger[]
  providerIdentities PaymentProviderIdentity[]
  expressionProfile  ExpressionProfile?
}

// ================================================================
// CurationJob — 用户信息整理任务（专项整理 AI 的执行追踪）
// 幂等去重由 dedupeKey 保证；状态：analyzed → saved/noop/review/partial/failed
// ================================================================
model CurationJob {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  dedupeKey     String    @unique
  status        String    @default("analyzed")
  trigger       String    @default("auto")   // auto | explicit | correction
  opsJson       String    @default("[]")
  appliedJson   String    @default("[]")
  errorSummary  String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId, createdAt])
  @@index([status])
}

model UserSetting {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultModel           String  @default("auto")
  defaultMode            String  @default("standard")
  theme                  String  @default("dark")
  enableVoice            Boolean @default(true)
  enableSearch           Boolean @default(true)
  teacherStyle           String  @default("guided")
  autoModelPool          String?
  modeModelPreferences   String?
  glassBlur              Int     @default(12)
  glassOpacity           Float   @default(0.06)
  glassBorderOpacity     Float   @default(0.12)
  glassRefraction        Int     @default(20)
  glassSaturate          Float   @default(1.8)
  glassHighlightOpacity  Float   @default(0.15)
  glassEnabled           Boolean @default(true)
  actionPolicies         String? @default("{}")
}

model AdminInvite {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String?
  usedBy    String?
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model MemoryEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Int      @default(1)
  category  String
  content   String
  source    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  balance     Float
  type        String
  description String?
  model       String?
  createdAt   DateTime @default(now())
}

model CreditBatch {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  remaining   Float
  source      String
  description String?
  expiryDate  DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([userId, isActive, expiryDate])
}

model CreditPack {
  id       String  @id @default(cuid())
  credits  Float
  price    Float
  currency String  @default("USD")
  isActive Boolean @default(true)
}

model ExchangeRate {
  id        String   @id @default(cuid())
  base      String   @default("USD")
  target    String
  rate      Float
  fetchedAt DateTime @default(now())
  @@unique([base, target])
}

model PaymentOrder {
  id              String              @id @default(cuid())
  orderId         String              @unique
  pricingVersionId  String?
  lockedCredits     Int?
  lockedPriceUsd    Float?
  creditGranted     Boolean  @default(false)
  creditGrantedAt   DateTime?
  creditValidDays   Int?
  fxVersionId       String?
  providerPricingVersionId String?
  creditPricingVersionId   String?
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            String
  expectedAmount  Float
  currency        String              @default("USD")
  paymentMethod   String
  recipient       String
status String @default("AWAITING_PAYMENT")
  verifiedTotal   Float               @default(0)
  remainingAmount Float               @default(0)
  expiresAt       DateTime
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  transactions    PaymentTransaction[]
  proofs          PaymentProof[]
  reviews         PaymentReview[]
  auditLogs       PaymentAuditLog[]
  payments        Payment[]
  attributions    PaymentAttribution[]
  @@index([userId, status])
}

model PaymentTransaction {
  id              String        @id @default(cuid())
  orderId         String
  order           PaymentOrder  @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  transactionId   String        @unique
  paymentMethod   String
  amount          Float
  currency        String
  recipient       String
  transactionTime DateTime
  providerStatus  String?
  referenceId     String?
  proofId         String?
  verifiedAt      DateTime?
  createdAt       DateTime      @default(now())
  @@index([orderId])
  @@index([transactionId])
}

model PaymentProof {
  id              String        @id @default(cuid())
  orderId         String
  order           PaymentOrder  @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  userId          String
  fileUrl         String
  fileHash        String
  perceptualHash  String?
  ocrResult       String?
  walletType      String?
  hasObstruction  Boolean       @default(false)
  uploadTime      DateTime      @default(now())
  createdAt       DateTime      @default(now())
  @@index([orderId])
  @@index([fileHash])
}

model PaymentReview {
  id              String         @id @default(cuid())
  orderId         String
  order           PaymentOrder  @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  proofId         String?
  decision        String
  aiOutput        String?
  riskScore       Float          @default(0)
  reason          String?
  reviewedAt      DateTime       @default(now())
  @@index([orderId])
}

model PaymentAuditLog {
  id        String        @id @default(cuid())
  orderId   String
  order     PaymentOrder @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  action    String
  detail    String?
  createdAt DateTime      @default(now())
  @@index([orderId, createdAt])
}

model PaymentQRCode {
  id        String   @id @default(cuid())
  method    String   @unique
  imageUrl  String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model LogEntry {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  level     String   @default("INFO")
  action    String
  detail    String?
  model     String?
  duration  Int?
  tokens    Int?
  credits   Float?
  createdAt DateTime @default(now())
}

model ModelUsage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  model      String
  tokenCount Int      @default(0)
  credits    Float    @default(0)
  callCount  Int      @default(0)
  date       DateTime @default(now())
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("bug")
  title       String
  content     String
  attachments String?
  status      String   @default("pending")
  reply       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RequestTrace {
  id                      String        @id
  requestId               String        @unique
  userId                  String?
  conversationId          String?
  messageId               String?
  parentMessageId         String?

  createdAt               DateTime      @default(now())
  startedAt               DateTime?
  completedAt             DateTime?
  durationMs              Int?

  environment             String?
  client                  String?
  appVersion              String?
  region                  String?
status String @default("QUEUED")

  requestedModel          String?
  selectedModel           String?
  provider                String?
  modelVersion            String?
  mode                    String?

  routingMode             String?
  routingPolicy           String?
  candidateModels         String?
  selectionReason         String?

  inputTokens             Int?
  cachedInputTokens       Int?
  cacheWriteTokens        Int?
  outputTokens            Int?
  reasoningTokens         Int?
  toolInputTokens         Int?
  toolOutputTokens        Int?
  totalTokens             Int?
  providerRawUsage        String?

  contextTokens           Int?
  systemPromptTokens      Int?
  conversationHistoryTokens Int?
  retrievalTokens         Int?
  toolContextTokens       Int?
  attachmentTokens        Int?
  userInputTokens         Int?

  requestStartedAt        DateTime?
  streamStartedAt         DateTime?
  firstTokenAt            DateTime?
  streamCompletedAt       DateTime?
  finalResponseAt         DateTime?
  ttftMs                  Int?
  streamDurationMs        Int?
  streamInterrupted       Boolean       @default(false)
  streamInterruptionReason String?

  inputCostUsd            Float?
  cachedInputCostUsd      Float?
  outputCostUsd           Float?
  toolCostUsd             Float?
  totalApiCostUsd         Float?
  pricingVersion          String?

  creditsBefore           Float?
  creditsReserved         Float?
  creditsCharged          Float?
  creditsRefunded         Float?
  creditsAfter            Float?
  creditPricingVersion    String?

  finishReason            String?
  cancelledBy             String?
  cancelledAt             DateTime?

  promptVersion           String?
  routerVersion           String?

  events                  Event[]
  modelCalls              ModelCall[]
  toolCalls               ToolCall[]
  errors                  ErrorLog[]
  billingTransactions     BillingTransaction[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([selectedModel])
  @@index([conversationId])
}

model Event {
  id              String    @id @default(cuid())
  traceId         String
  trace           RequestTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)
  requestId       String?
  userId          String?
  eventType       String
  timestamp       DateTime  @default(now())
  status          String?
  durationMs      Int?
  payload         String?
  errorId         String?
  version         String?

  @@index([traceId, eventType])
  @@index([timestamp])
  @@index([eventType, timestamp])
}

model ModelCall {
  id              String    @id @default(cuid())
  traceId         String
  trace           RequestTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)
  provider        String?
  requestedModel  String?
  selectedModel   String?
  modelVersion    String?
  mode            String?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  status          String?
  inputTokens     Int?
  outputTokens    Int?
  totalTokens     Int?
  cachedTokens    Int?
  reasoningTokens Int?
  providerRawUsage String?
  inputCostUsd    Float?
  outputCostUsd   Float?
  totalCostUsd    Float?
  finishReason    String?
  httpStatus      Int?
  errorMessage    String?

  @@index([traceId])
  @@index([selectedModel, status])
}

model ToolCall {
  id              String    @id @default(cuid())
  traceId         String
  trace           RequestTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)
  toolCallId      String?
  toolName        String?
  toolVersion     String?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  status          String?
  inputSize       Int?
  outputSize      Int?
  toolCostUsd     Float?
  errorCode       String?
  errorMessage    String?

  @@index([traceId])
  @@index([toolName])
}

model ErrorLog {
  id              String        @id @default(cuid())
  traceId         String
  trace           RequestTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)
  requestId       String?
  userId          String?
  timestamp       DateTime      @default(now())
  errorType       String?
  errorCode       String?
  message         String?
  stage           String?
  provider        String?
  model           String?
  httpStatus      Int?
  retryCount      Int           @default(0)
  recoverable     Boolean       @default(false)
  resolved        Boolean       @default(false)
severity String @default("ERROR")
  stack           String?

  @@index([traceId])
  @@index([errorType])
  @@index([stage])
  @@index([timestamp])
  @@index([severity])
}

model BillingTransaction {
  id               String   @id @default(cuid())
  traceId          String
  trace            RequestTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)
  requestId        String?
  userId           String?
  amount           Float
  balanceBefore    Float
  balanceAfter     Float
  reason           String?
  model            String?
  inputTokens      Int?
  outputTokens     Int?
  totalApiCostUsd  Float?
  pricingVersion   String?
  idempotencyKey   String?  @unique
  createdAt        DateTime @default(now())

  @@index([traceId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adaptiveProfile String     @default("{}")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  category        String
  content         String
  strength        Float    @default(0.5)
  confidence      Float    @default(0.5)
  evidenceCount   Int      @default(1)
  source          String   @default("inferred")
  status          String   @default("active")
  supersedes      String?
  supersededBy    String?
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())
  lastConfirmedAt DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([userId, status, category])
  @@index([userId, type])
}

model UserRequirement {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  content      String
  priority     String   @default("normal")
  status       String   @default("active")
  supersedes   String?
  supersededBy String?
  source       String   @default("explicit")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([userId, status])
}

model UserHabit {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  description     String
  confidence      Float    @default(0.3)
  evidenceCount   Int      @default(1)
  status          String   @default("candidate")
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([userId, status])
  @@index([userId, type])
}

model UserInterest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain          String
  topic           String   @default("*")
  strength        Float    @default(0.5)
  evidenceCount   Int      @default(1)
  status          String   @default("active")
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([userId, domain, topic])
  @@index([userId, status])
}

model DomainProfile {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain         String
  level          String   @default("unknown")
  confidence     Float    @default(0.3)
  evidenceCount  Int      @default(0)
  freshness      Float    @default(1.0)
  lastAssessedAt DateTime?
  lastObservedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subdomains     DomainSubdomain[]
  evidences      DomainEvidence[]
  @@unique([userId, domain])
  @@index([userId])
}

model DomainSubdomain {
  id              String        @id @default(cuid())
  domainProfileId String
  domainProfile   DomainProfile @relation(fields: [domainProfileId], references: [id], onDelete: Cascade)
  subdomain       String
  level           String        @default("unknown")
  confidence      Float         @default(0.3)
  evidenceCount   Int           @default(0)
  freshness       Float         @default(1.0)
  lastObservedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@unique([domainProfileId, subdomain])
}

model DomainEvidence {
  id              String        @id @default(cuid())
  domainProfileId String
  domainProfile   DomainProfile @relation(fields: [domainProfileId], references: [id], onDelete: Cascade)
  subdomain       String?
  evidenceType    String
  content         String
  impact          Float         @default(0)
  conversationId  String?
  messageId       String?
  createdAt       DateTime      @default(now())
  @@index([domainProfileId])
}

model LanguageProfile {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language               String
  overallProficiency     String   @default("unknown")
  confidence             Float    @default(0.3)
  evidenceCount          Int      @default(0)
  freshness              Float    @default(1.0)
  preferredExplanationLanguage String?
  status                 String   @default("active")
  lastAssessedAt         DateTime?
  lastObservedAt         DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  skills                 LanguageSkill[]
  vocabularies           LanguageVocabulary[]
  preferences            LanguagePreference[]
  @@unique([userId, language])
  @@index([userId])
}

model LanguageSkill {
  id                String           @id @default(cuid())
  languageProfileId String
  languageProfile   LanguageProfile  @relation(fields: [languageProfileId], references: [id], onDelete: Cascade)
  dimension         String
  level             String           @default("unknown")
  confidence        Float            @default(0.3)
  evidenceCount     Int              @default(0)
  lastObservedAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  @@unique([languageProfileId, dimension])
}

model LanguageVocabulary {
  id                String          @id @default(cuid())
  languageProfileId String
  languageProfile   LanguageProfile @relation(fields: [languageProfileId], references: [id], onDelete: Cascade)
  term              String
  status            String          @default("learning")
  evidenceCount     Int             @default(1)
  lastSeenAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  @@unique([languageProfileId, term])
  @@index([languageProfileId, status])
}

model LanguagePreference {
  id                String          @id @default(cuid())
  languageProfileId String
  languageProfile   LanguageProfile @relation(fields: [languageProfileId], references: [id], onDelete: Cascade)
  type              String
  value             String
  source            String          @default("explicit")
  status            String          @default("active")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  @@index([languageProfileId, status])
}

model LongTermMemory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  subtype         String?
  content         String
  structuredData  String?
  status          String   @default("active")
  confidence      Float    @default(0.5)
  importance      Float    @default(0.5)
  stability       Float    @default(0.5)
  freshness       Float    @default(1.0)
  evidenceCount   Int      @default(1)
  sourceType      String?
  sourceId        String?
  sourceVersion   Int?
  domain          String?
  conversationId  String?
  fileId          String?
  supersedes      String?
  supersededBy    String?
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())
  lastConfirmedAt DateTime?
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  events          MemoryEvent[]
  @@index([userId, type, status])
  @@index([userId, domain, status])
  @@index([userId, conversationId])
  @@index([userId, fileId])
  @@index([userId, freshness])
  @@index([userId, importance, status])
}

model MemoryEvent {
  id        String         @id @default(cuid())
  memoryId  String
  memory    LongTermMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  eventType String
  detail    String?
  metadata  String?
  createdAt DateTime       @default(now())
  @@index([memoryId])
  @@index([eventType, createdAt])
}

model FileRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  filename       String
  mimeType       String?
  size           Int?
  hash           String?
  version        Int      @default(1)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  versions       FileVersion[]
  facts          FileFact[]
  @@index([userId, status])
  @@index([hash])
}

model FileVersion {
  id        String     @id @default(cuid())
  fileId    String
  file      FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version   Int
  content   String
  summary   String?
  hash      String?
  createdAt DateTime   @default(now())
  @@unique([fileId, version])
}

model FileFact {
  id         String     @id @default(cuid())
  fileId     String
  file       FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)
  version    Int
  factType   String
  content    String
  confidence Float      @default(0.8)
  status     String     @default("active")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  @@index([fileId, status])
  @@index([fileId, version])
}

model PaymentProviderAccount {
  id              String          @id @default(cuid())
  provider        String
  accountId       String
  displayName     String?
  currency        String
  isActive        Boolean         @default(true)
  metadata        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([provider, accountId])
  @@index([provider, isActive])
}

model PaymentProviderIdentity {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  displayNames      String            @default("[]")
  normalizedNames   String            @default("[]")
  phone             String?
  email             String?
  accountId         String?
  firstObservedAt   DateTime        @default(now())
  lastObservedAt    DateTime        @default(now())
  verifiedCount     Int             @default(0)
  source            String          @default("verified_payment")
