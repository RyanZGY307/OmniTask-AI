// 地区级共享表达习惯：某 region 中 ≥70% 用户共有的表达习惯（聚合得出），注入该地区用户
model RegionExpressionHabit {
  id          String   @id @default(cuid())
  region      String   // 国家级，如 "CN"
  dimension   String   // vocabulary / sentence_pattern / abbreviation ...
  pattern     String   // 习惯词
  userCount   Int      @default(0)   // 该 region 拥有该 active pattern 的用户数（分子）
  regionTotal Int      @default(0)   // 该 region 有 active ExpressionProfile 的用户数（分母）
  ratio       Float    @default(0)   // userCount / regionTotal
  confidence  Float    @default(0.5)
  status      String   @default("active") // active / decayed
  computedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([region, dimension, pattern])
